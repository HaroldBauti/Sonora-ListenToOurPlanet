<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="SONORA convierte visualizaciones de la Tierra de la NASA, imágenes y videos en música accesible. Listen to our planet." />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;600&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["SONORA.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="RenderModeNoPrerender" />
</head>

<body>
    <noscript>SONORA necesita JavaScript para generar el audio.</noscript>
    @* Mientras arranca .NET (unos segundos) la página no estaría vacía ni muda: aviso y bienvenida por voz inmediata. *@
    <div id="sonora-cargando" class="cargando" role="status">
        <span class="logo" aria-hidden="true"></span>
        <p><strong>SONORA</strong> · Listen to our planet</p>
        <p>Cargando… Pulsa cualquier tecla o toca la pantalla para escuchar la bienvenida. · Loading… Press any key or tap to hear the welcome.</p>
    </div>
    <script src="@Assets["js/bienvenida.js"]"></script>
    <Routes @rendermode="RenderModeNoPrerender" />
    <script src="https://cdn.jsdelivr.net/npm/tone@14.7.77/build/Tone.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // Sin prerenderizado: la página usa JS (canvas, audio) desde el primer render.
    static readonly IComponentRenderMode RenderModeNoPrerender = new InteractiveWebAssemblyRenderMode(prerender: false);
}
