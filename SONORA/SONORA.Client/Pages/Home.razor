    /// <summary>Acción del asistente <c>load_map</c>: "tipo;año;región" o "serie;tipo;región".</summary>
    async Task<string> LoadMapAction(string value)
    {
        if (biomas is null || !BiomasReady) return "El atlas de biomas aún se está preparando en el servidor. Inténtalo en unos segundos.";
        var p = value.Split(';').Select(s => s.Trim()).ToArray();
        bool serie = p.ElementAtOrDefault(0) == "serie";
        string tipo = (serie ? p.ElementAtOrDefault(1) : p.ElementAtOrDefault(0)) ?? "biomas";
        string region = p.ElementAtOrDefault(2) is { Length: > 0 } r0 ? r0 : "peru"; // la región va tercera en ambos formatos
        if (biomas.Tipos.FirstOrDefault(t => t.Id == tipo) is not { } t) return $"No conozco el mapa «{tipo}».";
        if (biomas.Regiones.All(r => r.Id != region)) region = "peru";
        int? anio = !serie && t.UsaAnio && int.TryParse(p.ElementAtOrDefault(1), out var y) ? Math.Clamp(y, biomas.AnioMin, biomas.AnioMax) : null;

        if (serie && t.UsaAnio) await LoadBiomasSerie(tipo, region);
        else await LoadBiomas(tipo, t.UsaAnio ? anio ?? biomas.AnioMax : null, region);
        return error ?? $"Listo: {analysis?.Title}.";
    }

    async Task Run(Func<Task<AnalysisInfo>> load, bool optimize)
    {
        if (js is null) return;
        busy = loading = true; error = null; progressPct = 0; progressMsg = "Preparando…"; current = null;
        StateHasChanged();
        try
        {
            analysis = await load();
            summary = Describer.Summary(analysis);
            useManual = false;
            foreach (var r in Roles.All) await js.InvokeVoidAsync("setMute", r, muted[r]);
            await js.InvokeVoidAsync("setShowClass", showClass && analysis.Mode == "image");
            busy = false;
            StateHasChanged();
            if (optimize) await Optimize();
            else
            {
                pareto = await Http.GetFromJsonAsync<ParetoResult>("data/pareto-geos.json");
                await ApplyPareto();
            }
            await js.InvokeVoidAsync("seek", 0);
            status = $"{analysis.Title} listo: {analysis.Steps} pasos. {summary[0]} Pulsa Espacio para reproducir o usa las flechas.";
            // Cargado fuera de la guía (pestañas, botones, órdenes): la guía pasa a «listo» con lo que suena.
            if (guideOn && !guideLoading && !(guide.Section == "archivo" && analysis.Source == "upload")) guide.LoadedExternally(srcTab, analysis.Title);
            if (!guideLoading) await Say(status);
        }
        catch (JSException ex) { error = ex.Message.Split('\n')[0]; status = error; }
        catch (Exception ex) { error = $"No se pudo cargar: {ex.Message}"; status = error; }
        finally { busy = loading = false; StateHasChanged(); }
    }

