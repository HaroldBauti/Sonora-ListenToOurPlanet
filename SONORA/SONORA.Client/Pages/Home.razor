    // Orden: orientación y explicaciones; la guía (si está activa, según su contexto); lectura y navegación de la
    // página; reglas de música y mapa (instantáneas); y por último el modelo de OpenAI del servidor.
    async Task Ask(string question)
    {
        chat.Add(new("user", question));
        quietUntil = DateTime.MaxValue;
        string reply;
        try
        {
            // 0) «¿Dónde estoy?», «¿Qué puedo hacer aquí?», explicaciones y demostración: con o sin guía.
            var g = guide.Interpret(question);
            switch (g.Kind)
            {
                case GuideCommandKind.Where: await Reply(WhereText()); return;
                case GuideCommandKind.WhatCanIDo: await Reply(WhatCanIDoText()); return;
                case GuideCommandKind.Explain or GuideCommandKind.ExplainMore: await ExplainContent(g.Kind == GuideCommandKind.ExplainMore); return;
                case GuideCommandKind.Demo: await StartDemo(); return;
            }
            // 1) La guía: elegir, más opciones, volver, cambiar, reintentar… según su etapa.
            if (guideOn)
            {
                if (g.Kind == GuideCommandKind.Repeat && guide.Stage == GuideStage.Ready) { await Explain(lastReply.Length > 0 ? lastReply : guide.Prompt()); return; }
                if (g.Kind is GuideCommandKind.Back or GuideCommandKind.Menu or GuideCommandKind.Change) CancelDemo();
                if (guide.Stage == GuideStage.Demo && g.Kind == GuideCommandKind.Select) { await RunLesson(g.Value!); return; }
                if (guide.Apply(g, question) is { } guided) { await AfterGuide(guided); return; }
            }
            // 2) Lectura y navegación de la página ("lee la página", "ve a accesibilidad", "pulsa descargar video"…).
            //    "" = ya empezó a leer en voz alta: no hay que decir nada más.
            string? pageReply = js is null ? null : await js.InvokeAsync<string?>("pageCommand", question, speechRate);
            if (pageReply is not null)
            {
                if (pageReply.Length == 0) { quietUntil = DateTime.UtcNow.AddSeconds(1); StateHasChanged(); return; }
                await Reply(pageReply);
                return;
            }
            // 2) Órdenes de la música y del mapa (reglas). 3) Lo demás, al modelo.
            if (VoiceAssistant.Parse(question, analysis, scales) is { } intent)
            {
                var parts = new List<string>();
                if (intent.Reply is not null) parts.Add(intent.Reply);
                foreach (var act in intent.Actions) parts.Add(await Execute(act));
                reply = string.Join(" ", parts.Where(p => p.Length > 0));
            }
            else reply = await AskModel(question);
        }
        catch (Exception ex) { reply = $"Algo falló: {ex.Message}"; }
        await Reply(reply);
    }

    async Task<string> AskModel(string question)
    {
        if (analysis is null) return "Primero carga una imagen o el ejemplo de la NASA.";
        thinking = true; status = "Pensando…"; StateHasChanged();
        try
        {
            string OnOff(bool on) => on ? "sí" : "no";
            var settings = $"volumen {volume}/100; equilibrio {(pareto is null ? "sin calcular" : useManual ? "parámetros manuales" : $"{BalancePct}/100 (0 = lo más musical, 100 = lo más científico)")}" +
                           (pareto is null ? "" : $", fidelidad {Describer.Pct(Selection.Fidelity)}, musicalidad {Describer.Pct(Selection.Musicality)}") +
                           $"; narración {OnOff(speech)} a {speechRate.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)}x; vibración {OnOff(haptics)}" +
                           $"; alto contraste {OnOff(highContrast)}; texto grande {OnOff(largeText)}; ver capas {OnOff(showClass)}";
            var context = VoiceAssistant.Context(analysis, summary, current, tempo, Scale, scales, muted.Where(m => m.Value).Select(m => m.Key), settings);
            var history = chat.SkipLast(1).TakeLast(6).ToList();
            var resp = await Http.PostAsJsonAsync("api/assistant", new AssistantRequest(question, context, history));
            if ((int)resp.StatusCode == 503)
                return "No entendí esa orden y el asistente inteligente no está configurado en el servidor. Di «ayuda» para oír las órdenes.";
            if (!resp.IsSuccessStatusCode) return "No pude consultar al asistente inteligente. Inténtalo de nuevo o di «ayuda».";
            var r = (await resp.Content.ReadFromJsonAsync<AssistantReply>())!;
            var parts = new List<string> { r.Reply };
            foreach (var act in r.Actions)
            {
                var said = await Execute(act);
                if (act.Type is "describe" or "summary" or "help") parts.Add(said); // el resto ya lo confirma la respuesta del modelo
            }
            return string.Join(" ", parts);
        }
        finally { thinking = false; }
    }

    async Task Reply(string text)
    {
        lastReply = text;
        chat.Add(new("assistant", text));
        if (chat.Count > 20) chat.RemoveRange(0, chat.Count - 20);
        status = text;
        StateHasChanged();
        if (js is not null) await js.InvokeVoidAsync("assistantSay", text, speechRate);
        quietUntil = DateTime.UtcNow.AddSeconds(1);
    }

    /// <summary>Ejecuta una acción del asistente (de las reglas o del modelo) y devuelve una confirmación breve.</summary>
    async Task<string> Execute(AssistantAction act)
    {
        const string noMedia = "Primero carga una imagen o el ejemplo de la NASA.";
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        int Int(int fallback) => int.TryParse(act.Value, out var n) ? n : fallback;
        // "+20" / "-20" son relativos al valor actual; un número solo es absoluto.
        bool relative = act.Value.StartsWith('+') || act.Value.StartsWith('-');
        int Rel(int cur) => relative ? cur + Int(0) : Int(cur);
        bool on = act.Value != "off";
        switch (act.Type)
        {
            case "help": return VoiceAssistant.Help + " " + await js!.InvokeAsync<string>("navigationHelp");
            case "page_help": return await js!.InvokeAsync<string>("navigationHelp");
            case "hands_free":
                if (on && !voiceInSupported) return "Tu navegador no admite reconocimiento de voz. Usa Chrome o Edge para el modo manos libres.";
                handsFree = on;
                return on ? "Modo manos libres activado. Te escucho todo el tiempo; para terminar, di «desactiva manos libres»."
                          : "Modo manos libres desactivado. Pulsa M para volver a activarlo.";
            case "repeat": return lastReply.Length > 0 ? lastReply : "Todavía no he dicho nada.";
            case "narration": await SetSpeech(on); return on ? "Narración activada." : "Narración desactivada.";
            case "load_sample": await LoadSample(); return "Ejemplo de la NASA cargado.";
            case "load_map": return await LoadMapAction(act.Value);
            case "set_speech_rate":
                double.TryParse(act.Value, System.Globalization.NumberStyles.Float, inv, out var rate);
                speechRate = Math.Round(Math.Clamp(relative ? speechRate + rate : rate, 0.6, 1.8), 1);
                await SavePrefs();
                return $"Hablo a {speechRate.ToString("0.0", inv).Replace('.', ',')} veces.";
            case "haptics":
                if (!hapticsSupported) return "Este dispositivo no admite vibración.";
                await OnHaptics(new ChangeEventArgs { Value = on });
                return on ? "Vibración activada." : "Vibración desactivada.";
            case "high_contrast": highContrast = on; return on ? "Alto contraste activado." : "Alto contraste desactivado.";
            case "large_text": largeText = on; return on ? "Texto grande activado." : "Texto normal.";
        }
        if (analysis is null || js is null) return noMedia;
        switch (act.Type)
        {
            case "play": resumeAfterExplain = false; await js.InvokeVoidAsync("play"); return "Reproduciendo.";
            case "pause": resumeAfterExplain = false; CancelDemo(); await js.InvokeVoidAsync("pause"); return "En pausa.";
            case "next": return await GoTo(((current?.Step ?? -1) + 1) % analysis.Steps);
            case "prev": return await GoTo(((current?.Step ?? 0) - 1 + analysis.Steps) % analysis.Steps);
            case "goto_step": return await GoTo(Math.Clamp(Int(1), 1, analysis.Steps) - 1);
            case "play_at": return await GoTo(Math.Clamp(Int(1), 1, analysis.Steps) - 1, play: true);
            case "play_lon":
                // Los mapas (NASA de 180° O a 180° E, o Perú) en recorrido lineal se dividen en pasos de igual ancho de longitud.
                if (analysis.Box is not { } box || analysis.Scan != "linear") return "Solo puedo buscar lugares en un mapa con recorrido lineal.";
                if (!double.TryParse(act.Value, System.Globalization.NumberStyles.Float, inv, out var lon)) return "No encontré ese lugar.";
                if (lon < box.LonMin || lon > box.LonMax) return "Ese lugar queda fuera de este mapa.";
                return await GoTo(Math.Clamp((int)Math.Floor((lon - box.LonMin) / (box.LonMax - box.LonMin) * analysis.Steps), 0, analysis.Steps - 1), play: true);
            case "describe": return current is null ? "" : Describer.Step(current, analysis);
            case "summary": return $"{analysis.Alt} {summary.LastOrDefault()}";
            case "download_transcript": await DownloadTranscript(); return "Descripción descargada.";
            case "set_tempo":
                tempo = Math.Clamp(Rel(tempo), 50, 160);
                await js.InvokeVoidAsync("setTempo", tempo);
                return $"Tempo {tempo}.";
            case "set_volume":
                volume = Math.Clamp(Rel(volume), 0, 100);
                await js.InvokeVoidAsync("setVolume", volume);
                await SavePrefs();
                return $"Volumen {volume} %.";
            case "set_balance":
                if (pareto is not { Front.Count: > 0 } pf) return "Todavía no hay soluciones para equilibrar.";
                int pct = Math.Clamp(Rel(BalancePct), 0, 100);
                selected = (int)Math.Round(pct / 100.0 * (pf.Front.Count - 1)); useManual = false;
                await js.InvokeVoidAsync("setParams", Selection.Params);
                return $"{(pct < 34 ? "Más musical" : pct > 66 ? "Más científico" : "Equilibrado")}: fidelidad {Describer.Pct(Selection.Fidelity)}, musicalidad {Describer.Pct(Selection.Musicality)}.";
            case "manual_params":
                if (pareto is null) return "Todavía no hay parámetros cargados.";
                await UseManualParams();
                return "Parámetros manuales.";
            case "show_layers":
                if (analysis.Mode != "image") return "Las capas solo se pueden ver en imágenes.";
                showClass = on; await js.InvokeVoidAsync("setShowClass", on);
                return on ? "Mostrando las capas detectadas." : "Capas ocultas.";
            case "set_center":
                var xy = act.Value.Split(',');
                if (analysis.Mode != "image" || xy.Length != 2
                    || !double.TryParse(xy[0], System.Globalization.NumberStyles.Float, inv, out var fx)
                    || !double.TryParse(xy[1], System.Globalization.NumberStyles.Float, inv, out var fy))
                    return "No pude mover el centro del radar.";
                await Run(() => js!.InvokeAsync<AnalysisInfo>("setCenter", Math.Clamp(fx, 0, 1), Math.Clamp(fy, 0, 1)).AsTask(), optimize: true);
                return "Radar centrado ahí.";
            case "set_scale":
                var id = act.Value == "next" ? scales[(scales.FindIndex(s => s.Id == scaleId) + 1) % scales.Count].Id : act.Value;
                return await ApplyScale(id) ? $"Escala {Scale!.Name}, {Scale.Mood}." : "No conozco esa escala.";
            case "mute" or "unmute" or "solo":
                if (!muted.ContainsKey(act.Value)) return "No encontré esa capa.";
                var name = VoiceAssistant.LayerName(analysis, act.Value);
                if (act.Type == "solo")
                {
                    foreach (var r in muted.Keys.ToList()) await OnMute(r, r != act.Value);
                    return $"Solo suena: {name}.";
                }
                await OnMute(act.Value, act.Type == "mute");
                return $"{name}: {(act.Type == "mute" ? "en silencio" : "activada")}.";
            case "unmute_all":
                foreach (var r in muted.Keys.ToList()) await OnMute(r, false);
                return "Todas las capas activadas.";
            case "scan_radar" or "scan_linear":
                if (analysis.Mode != "image") return "El recorrido radar solo está disponible para imágenes.";
                await SetScan(act.Type == "scan_radar" ? "radar" : "linear");
                return act.Type == "scan_radar" ? "Recorrido radar: una línea gira desde las 12 alrededor del centro." : "Recorrido lineal.";
            default: return "";
        }
    }

    // Salta a un paso. Con play (o si ya sonaba) la música sigue sonando desde ahí y la confirmación es mínima;
    // sin play suena solo ese paso y se describe brevemente.
    async Task<string> GoTo(int c, bool play = false)
    {
        if (js is null || analysis is null) return "";
        bool keepPlaying = play || current?.Playing == true;
        if (keepPlaying) await js.InvokeVoidAsync("playFrom", c);
        else await js.InvokeVoidAsync("seek", c);
        var info = (await js.InvokeAsync<List<StepInfo>>("allSteps"))[c];
        current = info with { Playing = keepPlaying };
        if (play) return $"Sonando: {(info.Landmark is { } lm ? lm.Split(':')[0].TrimEnd('.') : info.StepLabel)}.";
        return Describer.Short(info, analysis) + (info.Landmark is null ? "" : " " + info.Landmark);
    }

    // ---------- Llamadas desde JS ----------
    [JSInvokable]
    public async Task OnStep(StepInfo info)
    {
        bool wasPlaying = current?.Playing == true;
        current = info;
        // Durante una explicación la música se pausa; si la persona la vuelve a poner, no se toca al terminar.
        if (explaining && info.Playing) resumeAfterExplain = false;
        if (analysis is not null && !loading && !explaining && DateTime.UtcNow >= quietUntil)
        {
            if (!info.Playing)
            {
                status = wasPlaying ? "Pausa. " + Describer.Step(info, analysis) : Describer.Step(info, analysis);
                await Say(wasPlaying ? status : Describer.Short(info, analysis) + (info.Landmark is null ? "" : " " + info.Landmark));
            }
            else if (info.LandmarkEntered && info.Landmark is not null)
            {
                // El lugar se muestra (y se anuncia) bajo el título "2. Escucha"; aquí solo se narra por voz.
                await Say(info.Landmark);
            }
            else if (!wasPlaying)
            {
                status = "Reproduciendo. Pausa con Espacio para escuchar la descripción del paso.";
            }
        }
        StateHasChanged();
    }

    // ---------- Primera interacción con la página ----------
    // La bienvenida es ahora un diálogo con dos botones (OpenWelcome). Aquí solo se desbloquea el audio con el primer
    // gesto; ya no se reproduce nada ni se enciende el micrófono por iniciativa propia.
    bool welcomed;
    [JSInvokable]
    public Task OnFirstInteraction(bool userIsActing, string introState)
    {
        if (welcomed || js is null) return Task.CompletedTask;
        welcomed = true;
        _ = js.InvokeVoidAsync("unlockAudio").AsTask();
        return Task.CompletedTask;
    }

    // ---------- Bienvenida accesible ----------
    string WelcomeText => lang == "en"
        ? "Welcome to Sonora. Listen to our planet. Do you need help to navigate? You can turn on the spoken guide or continue without it."
        : "Bienvenido a Sonora. Escucha nuestro planeta. ¿Necesitas ayuda para navegar? Puedes activar la guía hablada o continuar sin ella.";

    async Task OpenWelcome()
    {
        if (js is null) return;
        welcomeOpen = true;
        await js.InvokeVoidAsync("openWelcome", welcomeDlg);
        // Habla si el navegador ya lo permite; si no, con la primera tecla o toque (los botones hablan por su cuenta).
        await js.InvokeAsync<string>("speakWelcome", WelcomeText, speechRate);
    }

    async Task WelcomeChoice(bool accept)
    {
        if (!welcomeOpen || js is null) return;
        welcomeOpen = false;
        await js.InvokeVoidAsync("closeWelcome");
        guidePref = accept;
        await SavePrefs();
        if (accept) { await StartGuide(); return; }
        await js.InvokeVoidAsync("focusById", "sonoraTitle");
        await Reply("De acuerdo, continúas sin la guía. Cuando necesites ayuda, pulsa el botón Asistente, abajo a la derecha.");
    }

    // ---------- Guía hablada ----------
    async Task StartGuide()
    {
        guideOn = true; assistantOpen = true; guidePref = true;
        await SavePrefs();
        CancelDemo();
        string text = guide.Start();
        guideFocus++;
        StateHasChanged();
        await Reply("Guía hablada activada. Puedes elegir con el teclado, tocando las opciones o escribiendo; " +
                    "el micrófono solo se usa si pulsas «Usar micrófono». " + text);
    }

    async Task GuideOption(string id)
    {
        guideFocus++;
        if (guide.Stage == GuideStage.Demo) { await RunLesson(id); return; }
        await AfterGuide(guide.Select(id));
    }
    async Task GuideChange(string slot) { guideFocus++; CancelDemo(); await AfterGuide(guide.Change(slot)); }
    async Task GuideYear(int y) { guideFocus++; await AfterGuide(guide.Select($"year:{y}")); }
    async Task GuideMore() { guideFocus++; await AfterGuide(guide.More()); }
    async Task GuideLess() { guideFocus++; await AfterGuide(guide.Less()); }
    async Task GuideBack() { guideFocus++; CancelDemo(); await AfterGuide(guide.Back()); }
    async Task GuideMenu() { guideFocus++; CancelDemo(); await AfterGuide(guide.Menu()); }

    async Task GuideAction(string action)
    {
        guideFocus++;
        switch (action)
        {
            case "retry": await AfterGuide(guide.Retry()); break;
            case "back": await GuideBack(); break;
            case "menu": await GuideMenu(); break;
            case "toggle": await TogglePlay(); break;
            case "describe": await Reply(current is null || analysis is null ? "Todavía no hay nada sonando." : Describer.Step(current, analysis)); break;
            case "volup" or "voldown": await Reply(await Execute(new("set_volume", action == "volup" ? "+10" : "-10"))); break;
            case "explain": await ExplainContent(false); break;
            case "detail": await ExplainContent(true); break;
            case "demo": await StartDemo(); break;
        }
    }

    /// <summary>Dice lo que respondió la guía; si la selección quedó completa, la anuncia y la carga.</summary>
    async Task AfterGuide(string? text)
    {
        if (text is null) return;
        // La pantalla sigue a la guía: la pestaña visible es la sección que se está eligiendo.
        if (guide.Section is { } sec && sec != srcTab && guide.Stage != GuideStage.Menu) await SetSrcTab(sec);
        StateHasChanged();
        // Se decide antes de hablar: si mientras se anuncia la persona elige otra cosa, esta locución se corta y su
        // AfterGuide no debe cargar lo que pidió la acción nueva (se cargaría dos veces).
        bool load = guide.Stage == GuideStage.Loading;
        int version = guide.Version;
        await Reply(text);
        if (load && guide.Stage == GuideStage.Loading && guide.Version == version) await LoadGuideRequest();
    }

    async Task LoadGuideRequest()
    {
        if (guide.Request() is not { } req || js is null) return;
        guideLoading = true;
        try
        {
            error = null;
            var v = req.Values;
            switch (req.Section)
            {
                case "eic":
                    if (v["item"] == "sample") await LoadSample();
                    else if (eicItems.FirstOrDefault(i => i.Id == v["item"]) is { } item) await LoadEic(item);
                    else error = "esa visualización no está en el catálogo";
                    break;
                case "biomas":
                    if (v.GetValueOrDefault("periodo") == "serie") await LoadBiomasSerie(v["tipo"], v["region"]);
                    else await LoadBiomas(v["tipo"], v.TryGetValue("anio", out var ya) ? int.Parse(ya) : null, v["region"]);
                    break;
                case "clima":
                    var reg = guide.Data.Tendencias?.Regiones.FirstOrDefault(r => r.Id == v["region"]);
                    // «Las 4 que sugiere la red»: las primeras del catálogo, que ya viene ordenado por la red (como en la pestaña).
                    var codes = v["vars"] == "red"
                        ? reg?.Variables.Where(x => x.Fuente == v["fuente"]).Take(4).Select(x => x.Codigo).ToList() ?? []
                        : [.. v["pick"].Split(',', StringSplitOptions.RemoveEmptyEntries)];
                    if (codes.Count == 0) { error = "no hay variables para esa región con esos datos"; break; }
                    await LoadTendencias($"api/tendencias/serie?region={Uri.EscapeDataString(v["region"])}&fuente={Uri.EscapeDataString(v["fuente"])}&vars={Uri.EscapeDataString(string.Join(',', codes))}");
                    break;
                case "mundo":
                    if (WorldPlaces.FirstOrDefault(p => p.Id == v["lugar"]) is not { } wp) { error = "ese lugar no está en la lista"; break; }
                    worldPlace = wp.Id;
                    if (srcTab != "mundo") await SetSrcTab("mundo");
                    await js.InvokeVoidAsync("refreshMaps");
                    await js.InvokeVoidAsync("worldGoTo", wp.Lat, wp.Lon, wp.Zoom);
                    bool serie = v.GetValueOrDefault("periodo") == "serie";
                    if (!serie && v.TryGetValue("anio", out var wy)) { wAnio = int.Parse(wy); await js.InvokeVoidAsync("worldSetYear", wAnio); }
                    await Task.Delay(400); // Leaflet termina de ajustar la vista antes de leer el recuadro
                    await LoadMundo(serie);
                    break;
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException) { error = ex.Message; }
        finally { guideLoading = false; }

        guideFocus++;
        if (error is not null || analysis is null) { await Reply(guide.Fail(error ?? "no se pudo cargar")); return; }
        guide.Loaded(analysis.Title);
        StateHasChanged();
        // Antes de reproducir: qué es, fuente, periodo y cómo suena. No se reproduce solo.
        await Explain("Listo. " + Explainer.Simple(analysis, meta) +
                      " Pulsa «Reproducir» o di «reproduce». También puedes pedir la explicación detallada o aprender a escuchar.");
    }

    // ---------- Explicaciones (la música se pausa mientras tanto y se restaura después) ----------
    int explainGen;
    async Task Explain(string text)
    {
        int gen = ++explainGen;
        bool wasPlaying = current?.Playing == true;
        // Una explicación nueva que interrumpe a otra hereda su intención de reanudar (la música la pausó la anterior).
        resumeAfterExplain = explaining ? resumeAfterExplain || wasPlaying : wasPlaying;
        explaining = true;
        quietUntil = DateTime.MaxValue;
        try
        {
            if (wasPlaying && js is not null) await js.InvokeVoidAsync("pause");
            await Reply(text);
        }
        finally
        {
            // Solo la explicación más reciente restaura el estado: así una interrumpida no reanuda la música en medio de otra.
            if (gen == explainGen)
            {
                explaining = false;
                // Se reanuda si sonaba antes y la persona no pausó ni reprodujo durante la explicación.
                if (resumeAfterExplain && current?.Playing != true && js is not null) await js.InvokeVoidAsync("play");
                resumeAfterExplain = false;
            }
        }
    }

    async Task ExplainContent(bool detailed)
    {
        if (analysis is null) { await Reply("Todavía no hay contenido cargado. Elige primero qué escuchar."); return; }
        CancelDemo(); // una explicación pedida detiene la demostración en curso
        await Explain(detailed ? Explainer.Detailed(analysis, meta, Scale) : Explainer.Simple(analysis, meta));
    }

    // ---------- Aprender a escuchar: una capa sola, donde tiene más y donde tiene menos ----------
    async Task StartDemo()
    {
        if (analysis is null) { await Reply("Primero elige qué escuchar; después te enseño a escuchar cada capa."); return; }
        CancelDemo();
        guideOn = true; assistantOpen = true;
        var layers = analysis.Layers
            .Select(l => new GuideOption(l.Role, l.Name, $"suena como {Roles.Es(l.Role)}, con {Roles.Instrument(l.Role)}")).ToList();
        guideFocus++;
        StateHasChanged();
        await Reply(guide.EnterDemo(layers) + " " + SoundRules.Sonification);
    }

    void CancelDemo() => demoCts?.Cancel();

    async Task RunLesson(string id)
    {
        if (analysis is null || js is null) return;
        CancelDemo();
        var cts = demoCts = new CancellationTokenSource();
        List<string> roles = id == "__all" ? [.. analysis.Layers.Select(l => l.Role)] : [id];
        if (roles.Any(r => !analysis.Col.ContainsKey(r))) return;
        var saved = muted.ToDictionary(m => m.Key, m => m.Value);
        int savedStep = current?.Step ?? 0;
        if (current?.Playing == true) await js.InvokeVoidAsync("pause");
        // Se detiene si la pidieron parar o si la guía ya salió de la demostración mientras hablaba.
        void StillInLesson() { cts.Token.ThrowIfCancellationRequested(); if (guide.Stage != GuideStage.Demo) throw new OperationCanceledException(); }
        try
        {
            foreach (var role in roles)
            {
                var (text, max, min) = Explainer.LayerLesson(analysis, role, Scale);
                await Reply(text);
                StillInLesson();
                foreach (var r in muted.Keys.ToList()) await OnMute(r, r != role);
                StateHasChanged(); // las casillas de capas muestran cuál suena sola
                await js.InvokeVoidAsync("playFrom", max);
                await Task.Delay(4000, cts.Token);
                await js.InvokeVoidAsync("pause");
                await Reply("Ahora, donde hay menos.");
                StillInLesson();
                await js.InvokeVoidAsync("playFrom", min);
                await Task.Delay(4000, cts.Token);
                await js.InvokeVoidAsync("pause");
            }
            await RestoreAfterLesson(saved, savedStep);
            await Reply("Fin de la demostración: todas las capas vuelven a sonar como antes. Elige otra capa, o di «volver» para seguir escuchando.");
        }
        catch (OperationCanceledException)
        {
            await js.InvokeVoidAsync("pause");
            await RestoreAfterLesson(saved, savedStep);
        }
        finally { if (demoCts == cts) demoCts = null; }
    }

    async Task RestoreAfterLesson(Dictionary<string, bool> saved, int step)
    {
        foreach (var (r, m) in saved) await OnMute(r, m);
        if (js is not null && analysis is not null) await js.InvokeVoidAsync("seek", Math.Clamp(step, 0, analysis.Steps - 1));
        StateHasChanged();
    }

    // ---------- Voz propia, interrupción, orientación y corrección ----------
    async Task StopVoice()
    {
        CancelDemo();
        if (js is not null) await js.InvokeVoidAsync("stopVoice");
        status = "Voz detenida.";
    }

    async Task SetOwnVoice(bool on)
    {
        ownVoice = on;
        if (js is not null) await js.InvokeVoidAsync("setOwnVoice", on);
        await SavePrefs();
        if (on) await Reply("Voz de SONORA activada.");
        else status = "Voz de SONORA desactivada: los textos se anuncian por tu lector de pantalla.";
    }

    async Task CorrectHeard()
    {
        typed = lastHeard ?? "";
        StateHasChanged();
        if (js is not null) await js.InvokeVoidAsync("focusById", "askText");
    }

    string WhereText()
    {
        string state = StateLabel;
        if (guideOn) return guide.Where(state, srcTab, analysis?.Title, current?.StepLabel);
        return $"Estás en la pestaña {GuideFlow.SectionName(srcTab)}." +
               (analysis is null ? " Todavía no hay contenido cargado." : $" Contenido cargado: {analysis.Title}.") +
               (state.Length > 0 ? $" Estado: {state.ToLowerInvariant()}{(current?.StepLabel is { } st ? $", en {st}" : "")}." : "") +
               " La guía hablada está desactivada; puedes activarla con el botón Asistente.";
    }

    string WhatCanIDoText()
    {
        bool mic = voiceInSupported && !micBlocked;
        if (guideOn) return guide.WhatCanIDo(analysis is not null, current?.Playing == true, mic);
        var acts = new List<string> { "activar la guía hablada con el botón Asistente", "elegir qué escuchar en las pestañas de la sección 1" };
        if (analysis is not null)
            acts.AddRange([current?.Playing == true ? "pausar" : "reproducir", "subir o bajar el volumen", "describir el momento actual",
                           "pedir una explicación sencilla o detallada", "aprender a escuchar cada capa"]);
        acts.Add("detener la voz con Escape o Control");
        acts.Add(mic ? "usar el micrófono con la tecla A" : "escribir órdenes en el asistente");
        return "Aquí puedes: " + string.Join("; ", acts) + ".";
    }

    [JSInvokable]
    public void OnProgress(int pct, string msg) { progressPct = pct; progressMsg = msg; StateHasChanged(); }

    [JSInvokable]
    public async Task OnShortcut(string key)
    {
        switch (key)
        {
            case "a": await ToggleListen(); break;
            case "l": if (js is not null) await js.InvokeVoidAsync("toggleReading", speechRate); break;
            case "m": await SetHandsFree(!handsFree); break;
            case "d": await DescribeCurrent(); break;
            case "e": await CycleScale(); break;
            case "h": await ShowHelp(); break;
            case "v": await SetSpeech(!speech); break;
            case "1" or "2" or "3" or "4" or "5":
                var role = key == "5" ? "points" : Roles.All[int.Parse(key) - 1];
                if (role == "points" && analysis?.Points is not { Count: > 0 }) break;
                await OnMute(role, !muted[role]);
                var name = role == "points" ? "Destellos" : analysis?.Layers.FirstOrDefault(l => l.Role == role)?.Name ?? Roles.Es(role);
                status = role == "points"
                    ? $"Destellos {(muted[role] ? "silenciados" : "activados")}."
                    : $"{name} ({Roles.Es(role)}) {(muted[role] ? "silenciada" : "activada")}.";
                await Say(status);
                break;
        }
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try { if (js is not null) { await js.InvokeVoidAsync("dispose"); await js.DisposeAsync(); } }
        catch (JSDisconnectedException) { }
        self?.Dispose();
    }
