@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject HttpClient Http

<PageTitle>SONORA · Listen to our planet</PageTitle>

<div class="sonora @(largeText ? "large-text" : "") @(highContrast ? "high-contrast" : "")">
    <a class="skip-link" href="#player">Saltar al reproductor</a>

    <header class="hero">
        <div class="brand">
            <span class="logo" aria-hidden="true"></span>
            <div>
                <h1 id="sonoraTitle" tabindex="-1">SONORA</h1>
                <p class="slogan" lang="en">LISTEN TO OUR PLANET</p>
            </div>
        </div>
        @if (translatorNote is not null)
        {
            <p class="hint" role="status" data-no-tr lang="en">@translatorNote</p>
        }
        <p class="lead">Convierte las visualizaciones de la Tierra de la NASA —o tu propia imagen o video— en música que se puede escuchar, explorar y entender sin necesidad de verla.</p>
    </header>

    <main>
        <!-- ===================== Fuente ===================== -->
        <section class="card source" aria-labelledby="srcTitle">
            <h2 id="srcTitle">1. Elige qué escuchar</h2>
            <TabBar Prefix="src" Label="Qué escuchar" Tabs="SrcTabs" Active="@srcTab" ActiveChanged="SetSrcTab" />

            <div id="src-panel-eic" role="tabpanel" aria-labelledby="src-tab-eic" class="tabpanel" hidden="@(srcTab != "eic")">
                <EicJukebox @ref="eicBox" Busy="busy" OnListen="LoadEic" OnSample="LoadSample" />
            </div>

            <div id="src-panel-archivo" role="tabpanel" aria-labelledby="src-tab-archivo" class="tabpanel" hidden="@(srcTab != "archivo")">
            <div class="source-grid">
                <div class="upload">
                    <label for="mediaFile" class="btn btn-outline">⬆ Sube una imagen o video</label>
                    <InputFile id="mediaFile" @ref="fileInput" OnChange="OnFileChanged" accept="image/*,video/*" disabled="@busy" class="visually-hidden" aria-describedby="uploadHelp" />
                    <p id="uploadHelp" class="hint">PNG, JPG, WebP, MP4 o WebM (máx. 300 MB). Se procesa en tu navegador: el archivo no se sube a ningún servidor.</p>
                </div>
                <div class="describe-own">
                    <label for="userDesc">Descripción de tu archivo (opcional, recomendado para accesibilidad)</label>
                    <textarea id="userDesc" rows="2" @bind="userDescription" placeholder="Ej.: Temperatura del mar en el Pacífico durante El Niño 2023"></textarea>
                </div>
            </div>
            </div>

            <div id="src-panel-biomas" role="tabpanel" aria-labelledby="src-tab-biomas" class="tabpanel" hidden="@(srcTab != "biomas")">
            <fieldset class="peru" aria-describedby="peruHelp">
                <legend>🇵🇪 Biomas de Perú <span class="hint">(red neuronal + datos NASA, generado al instante)</span></legend>
                @if (biomas is null)
                {
                    <p class="hint" role="status">Consultando el atlas de biomas…</p>
                }
                else
                {
                    <div class="peru-grid">
                        <label>Mapa
                            <select @bind="bTipo" disabled="@busy">
                                @foreach (var t in biomas.Tipos)
                                {
                                    <option value="@t.Id">@t.Nombre</option>
                                }
                            </select>
                        </label>
                        <label>Región
                            <select @bind="bRegion" disabled="@busy">
                                @foreach (var r in biomas.Regiones)
                                {
                                    <option value="@r.Id">@r.Nombre</option>
                                }
                            </select>
                        </label>
                        <label>Año
                            <input type="range" min="@biomas.AnioMin" max="@biomas.AnioMax" @bind="bAnio" @bind:event="oninput"
                                   disabled="@(busy || BTipo?.UsaAnio != true)" aria-valuetext="@(BTipo?.UsaAnio == true ? bAnio.ToString() : "no aplica")" />
                            <span class="val">@(BTipo?.UsaAnio == true ? bAnio.ToString() : $"{biomas.AnioMin}–{biomas.AnioMax}")</span>
                        </label>
                    </div>
                    <p id="peruHelp" class="hint">@BTipo?.Descripcion Capas: @string.Join(", ", BTipo?.Paleta.Select(p => $"{p.Name} ({Roles.Es(p.Role)})") ?? [])</p>
                    <div class="peru-actions">
                        <button type="button" class="btn" @onclick="() => LoadBiomas(bTipo, BTipo?.UsaAnio == true ? bAnio : null, bRegion)" disabled="@(busy || !BiomasReady)">🎧 Escuchar mapa</button>
                        <button type="button" class="btn btn-outline" @onclick="() => LoadBiomasSerie(bTipo, bRegion)" disabled="@(busy || !BiomasReady || BTipo?.UsaAnio != true)">▶ Escuchar @biomas.AnioMin–@biomas.AnioMax año por año</button>
                        @if (BiomasReady)
                        {
                            <a href="@($"api/biomas/mapa?tipo={bTipo}&region={bRegion}&estilo=vista" + (BTipo?.UsaAnio == true ? $"&anio={bAnio}" : ""))" target="_blank" rel="noopener">Ver versión detallada ↗</a>
                        }
                    </div>
                    @if (!BiomasReady)
                    {
                        <p class="hint" role="status">@(biomas.Estado == "error" ? $"El atlas no está disponible: {biomas.Error}" : $"Preparando el atlas en el servidor ({biomas.Estado})… tarda unos segundos al arrancar.")</p>
                    }
                }
            </fieldset>
            </div>

            <div id="src-panel-clima" role="tabpanel" aria-labelledby="src-tab-clima" class="tabpanel" hidden="@(srcTab != "clima")">
                <TendenciasPeru Busy="busy" OnListen="LoadTendencias" />
            </div>

            <div id="src-panel-mundo" role="tabpanel" aria-labelledby="src-tab-mundo" class="tabpanel" hidden="@(srcTab != "mundo")">

            <fieldset class="world" aria-describedby="worldHelp">
                <legend>🌎 Todo el planeta <span class="hint">(cobertura terrestre de la NASA, 2001–2024)</span></legend>
                <p id="worldHelp" class="hint">
                    Mueve el mapa o elige un lugar y pulsa «Escuchar esta zona». Se usa la clasificación oficial MODIS IGBP de la NASA
                    (no la red neuronal, que está entrenada solo con Perú), agrupada en 4 capas: Bosque (melodía), Agricultura y urbano (ritmo),
                    Sabana, matorral y pastizal (bajo) y Desierto y hielo (armonía). Solo suena el recuadro claro del centro (lo gris queda fuera; máximo 40° de lado). Para elegir tu propia zona, mantén Mayús y arrastra sobre el mapa; clic derecho vuelve al recuadro automático.
                </p>
                <div class="world-grid">
                    <label>Lugar
                        <select value="@worldPlace" @onchange="OnWorldPlace" disabled="@busy">
                            <option value="">— Elige un lugar o mueve el mapa —</option>
                            @foreach (var p in WorldPlaces)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </label>
                    <label>Año
                        <input type="range" min="2001" max="2024" value="@wAnio" @oninput="OnWorldYear" disabled="@busy" aria-valuetext="@wAnio" />
                        <span class="val">@wAnio</span>
                    </label>
                </div>
                <div class="world-map" @ref="worldMapEl" role="application" aria-label="Mapa del mundo con la cobertura terrestre de la NASA. Usa las flechas para moverte y más o menos para acercarte." tabindex="0"></div>
                <div class="peru-actions">
                    <button type="button" class="btn" @onclick="() => LoadMundo(false)" disabled="@busy">🎧 Escuchar esta zona (@wAnio)</button>
                    <button type="button" class="btn btn-outline" @onclick="() => LoadMundo(true)" disabled="@busy">▶ Escuchar 2001–2024 año por año</button>
                </div>
            </fieldset>
            </div>
            @if (busy)
            {
                <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@progressPct" aria-label="Progreso del análisis">
                    <div style="width:@(progressPct)%"></div>
                </div>
                <p class="hint">@progressMsg</p>
            }
            @if (error is not null)
            {
                <p class="error" role="alert">@error</p>
            }
        </section>

        <!-- ===================== Reproductor ===================== -->
        <section id="player" class="card" aria-labelledby="playerTitle" tabindex="-1">
            <h2 id="playerTitle">2. Escucha@(analysis is null ? "" : $": {analysis.Title}")</h2>
            @if (analysis?.Event is { } yearEvent)
            {
                <p class="landmark-now event">📅 Este año: @yearEvent</p>
            }
            <p class="landmark-now" role="status" aria-live="polite">@(current?.Landmark is { } lmNow ? $"📍 Aquí: {lmNow}" : "")</p>

            <div class="stage-row">
                <div class="stage" @ref="stage" role="application" tabindex="0"
                     aria-roledescription="explorador sonoro"
                     aria-label="@StageLabel" aria-describedby="kbdHelp">
                    <img @ref="img" alt="" hidden />
                    <video @ref="video" hidden muted playsinline aria-hidden="true"></video>
                    <canvas @ref="canvas" aria-hidden="true"></canvas>
                </div>
                @* Leyenda (año o periodo, colores y valores): la llena sonora.js; el texto ya llega por la región aria-live *@
                <aside class="geo-legend" @ref="legendEl" aria-hidden="true" hidden></aside>
            </div>
            <p id="kbdHelp" class="hint">
                <kbd>Espacio</kbd> reproducir o pausar · <kbd>←</kbd> <kbd>→</kbd> pasos · <kbd>↑</kbd> <kbd>↓</kbd> explorar franjas · <kbd>Esc</kbd> volver al paso completo · <kbd>A</kbd> micrófono del asistente · <kbd>M</kbd> manos libres · <kbd>L</kbd> leer la página · <kbd>D</kbd> describir · <kbd>V</kbd> voz · <kbd>E</kbd> escala · <kbd>1</kbd>–<kbd>5</kbd> capas · <kbd>H</kbd> ayuda
            </p>

            <div class="controls">
                <button type="button" class="btn btn-play" @onclick="TogglePlay" disabled="@(analysis is null)" aria-keyshortcuts="Space">
                    @(current?.Playing == true ? "⏸ Pausar" : "▶ Reproducir")
                </button>
                <label>Tempo <input type="range" min="50" max="160" value="@tempo" @oninput="OnTempo" aria-valuetext="@($"{tempo} pulsos por minuto")" /> <span class="val">@tempo BPM</span></label>
                <label>Volumen <input type="range" min="0" max="100" value="@volume" @oninput="OnVolume" aria-valuetext="@($"{volume} por ciento")" /> <span class="val">@volume %</span></label>
                @if (analysis?.Scan == "years")
                {
                    <label>Segundos por año <input type="range" min="1" max="10" value="@yearSec" @oninput="OnYearSec" aria-valuetext="@($"{yearSec} segundos por año, {yearSec * analysis.Steps} segundos la serie completa")" /> <span class="val">@yearSec s</span></label>
                }
                @if (scales.Count > 0)
                {
                    <label>Escala
                        <select value="@scaleId" @onchange="OnScale" aria-describedby="scale-desc" aria-keyshortcuts="E">
                            @foreach (var sc in scales)
                            {
                                <option value="@sc.Id">@sc.Name</option>
                            }
                        </select>
                    </label>
                }
                @if (analysis?.Mode == "image")
                {
                    <label><input type="checkbox" checked="@showClass" @onchange="OnShowClass" /> Ver capas detectadas</label>
                }
                <button type="button" class="btn btn-outline" @onclick="DescribeCurrent" disabled="@(current is null)" aria-keyshortcuts="D">🗣 Describir este paso</button>
                <button type="button" class="btn btn-outline @(recording == "audio" ? "is-listening" : "")" @onclick="() => Record(false)"
                        disabled="@(analysis is null || busy || recording == "video")" aria-pressed="@(recording == "audio" ? "true" : "false")">
                    @(recording == "audio" ? "⏹ Grabando… (pulsa para terminar)" : "⏺ Descargar audio de la pieza")
                </button>
                <button type="button" class="btn btn-outline @(recording == "video" ? "is-listening" : "")" @onclick="() => Record(true)"
                        disabled="@(analysis is null || busy || recording == "audio")" aria-pressed="@(recording == "video" ? "true" : "false")">
                    @(recording == "video" ? "⏹ Grabando video… (pulsa para terminar)" : "🎬 Descargar video con sonido")
                </button>
            </div>
            @if (Scale is { } curScale)
            {
                <p id="scale-desc" class="hint scale-desc">Escala <strong>@curScale.Name</strong>, @curScale.Mood. Notas: @curScale.Notes. Acordes: @curScale.Chords.</p>
            }

            <div class="now" aria-hidden="true">@(current is null || analysis is null ? "" : Describer.Short(current, analysis))</div>
            <div class="status" role="status" aria-live="polite" aria-atomic="true">@status</div>

            <TabBar Prefix="pl" Label="Detalles de lo que suena" Tabs="PlayerTabs" Active="@playerTab" ActiveChanged="SetPlayerTab" />

            <div id="pl-panel-capas" role="tabpanel" aria-labelledby="pl-tab-capas" class="tabpanel" hidden="@(playerTab != "capas")">
            @if (analysis is null)
            {
                <p class="hint">Elige arriba qué escuchar para ver sus capas.</p>
            }
            @if (analysis is not null)
            {
                <fieldset class="scan">
                    <legend>Recorrido</legend>
                    <label>
                        <input type="radio" name="scan" checked="@(analysis.Scan != "radar")" disabled="@(analysis.Mode != "image" || busy || optimizing)" @onchange='() => SetScan("linear")' />
                        Lineal (@(analysis.Scan == "years" ? "año por año" : analysis.Mode == "video" ? "en el tiempo del video" : analysis.Box is not null ? "de oeste a este" : "de izquierda a derecha"))
                    </label>
                    <label>
                        <input type="radio" name="scan" checked="@(analysis.Scan == "radar")" disabled="@(analysis.Mode != "image" || busy || optimizing)" @onchange='() => SetScan("radar")' />
                        Radar (gira desde un centro, como Caldwell 73 de la NASA)
                    </label>
                    @if (analysis.Scan == "radar")
                    {
                        <button type="button" class="btn btn-small btn-outline" @onclick="ResetCenter" disabled="@(busy || optimizing)">Centrar en la imagen</button>
                    }
                    <p class="hint">
                        @(analysis.Mode != "image"
                            ? "El radar está disponible solo para imágenes."
                            : "En modo radar, haz doble clic en la imagen para mover el centro (por ejemplo, sobre el ojo de un huracán). Las flechas ↑ ↓ recorren anillos desde el centro.")
                    </p>
                </fieldset>
            }

            @if (analysis is not null)
            {
                <div class="layers">
                    @foreach (var (l, i) in analysis.Layers.Select((l, i) => (l, i)))
                    {
                        var v = current?.Values.GetValueOrDefault(l.Role) ?? 0;
                        <div class="layer @(muted[l.Role] ? "is-muted" : "")">
                            <div class="layer-head">
                                <span class="sw" style="background:@Rgb(l.Rgb)" aria-hidden="true"></span>
                                <span class="layer-name">@l.Name</span>
                                <label class="layer-toggle">
                                    <input type="checkbox" checked="@(!muted[l.Role])" @onchange="e => OnMute(l.Role, !(bool)e.Value!)" aria-keyshortcuts="@(i + 1)" />
                                    @Roles.Es(l.Role)
                                </label>
                            </div>
                            <div class="meter" aria-hidden="true"><div style="width:@(Math.Round(v * 100))%;background:@Rgb(l.Rgb)"></div></div>
                            <div class="val">
                                @Describer.Pct(v)
                                @if (current is not null && Describer.ChangeMark(l.Role, current) is { } chg)
                                {
                                    <span class="delta @(chg.StartsWith('▲') ? "up" : chg.StartsWith('▼') ? "down" : "")" title="Cambio respecto al año anterior, en puntos">@chg</span>
                                }
                                · @(current is null ? "—" : Describer.LayerDetail(l.Role, current))
                            </div>
                        </div>
                    }
                    @if (analysis.Points is { Count: > 0 } pts)
                    {
                        var n = current?.Points ?? 0;
                        <div class="layer @(muted["points"] ? "is-muted" : "")">
                            <div class="layer-head">
                                <span class="sw sw-points" aria-hidden="true"></span>
                                <span class="layer-name">Destellos</span>
                                <label class="layer-toggle">
                                    <input type="checkbox" checked="@(!muted["points"])" @onchange='e => OnMute("points", !(bool)e.Value!)' aria-keyshortcuts="5" />
                                    marimba / glock.
                                </label>
                            </div>
                            <div class="meter" aria-hidden="true"><div class="meter-points" style="width:@(Math.Min(100, n * 100 / 6))%"></div></div>
                            <div class="val">@(current is null ? "—" : Describer.PointsText(current)) · @pts.Count en total</div>
                        </div>
                    }
                </div>
            }
            </div>

            <div id="pl-panel-mapa" role="tabpanel" aria-labelledby="pl-tab-mapa" class="tabpanel" hidden="@(playerTab != "mapa")">
                @if (analysis?.Box is null)
                {
                    <p class="hint">@(analysis is null ? "Elige arriba qué escuchar." : "Esta fuente no tiene coordenadas geográficas: el mapa con contexto está disponible para Biomas de Perú, Clima de Perú, Todo el planeta y el ejemplo de aerosoles.")</p>
                }
                <div class="ctx-wrap @(analysis?.Box is null ? "is-hidden" : "")">
                    <p class="hint ctx-caption">🗺 Mapa con contexto (OpenStreetMap): lo que está en gris no suena; el recuadro amarillo marca el paso que está sonando. Arrastra, usa la rueda o los botones + y − para acercarte.</p>
                    <div class="ctx-map" @ref="ctxMapEl" aria-hidden="true"></div>
                </div>
            </div>

            <div id="pl-panel-info" role="tabpanel" aria-labelledby="pl-tab-info" class="tabpanel" hidden="@(playerTab != "info")">
            @if (analysis is null)
            {
                <p class="hint">Elige arriba qué escuchar para ver su descripción.</p>
            }
            else
            {
                <h3>Descripción de la imagen</h3>
                <p>@analysis.Alt</p>
                @if (analysis.Context is not null)
                {
                    <h3>Contexto científico</h3>
                    <p>@analysis.Context</p>
                }
                <h3>Cómo suena cada capa</h3>
                @if (Scale is { } sc2)
                {
                    <p>Todas las notas salen de la escala <strong>@sc2.Name</strong> (@sc2.Mood): @sc2.Notes. Progresión de acordes: @sc2.Chords.</p>
                }
                <ul class="mapping">
                    @foreach (var l in analysis.Layers)
                    {
                        <li><span class="sw" style="background:@Rgb(l.Rgb)" aria-hidden="true"></span> <strong>@l.Name</strong> → @Roles.Es(l.Role) (@Roles.Instrument(l.Role)). @SoundRules.Role(l.Role, Scale)</li>
                    }
                    @if (analysis.Points is { Count: > 0 })
                    {
                        <li><span class="sw sw-points" aria-hidden="true"></span> <strong>Destellos</strong> (puntos brillantes aislados) → marimba si son rojos, naranjas o amarillos; glockenspiel si son azules o blancos. Cada uno suena cuando el barrido pasa por él; @(analysis.Scan == "radar" ? "más lejos del centro, más agudo" : "más arriba, más agudo").</li>
                    }
                </ul>
                <h3>Resumen del recorrido</h3>
                <ul>
                    @foreach (var line in summary)
                    {
                        <li>@line</li>
                    }
                </ul>
                @if (analysis.Source is "upload" or "eic")
                {
                    <p class="hint">Los colores se agruparon automáticamente en 4 familias (k-means). La más extensa suena como armonía de fondo; las demás como melodía, ritmo y bajo. Las intensidades son relativas dentro de @(analysis.Source == "eic" ? "esta visualización" : "tu archivo").</p>
                }
                else
                {
                    <p class="hint">Cada píxel se compara con los colores de la barra oficial de la NASA. Las intensidades son relativas dentro de esta imagen, no concentraciones absolutas.</p>
                }
            }
            </div>

        </section>

        @* Asistente flotante: botón fijo y con texto visible en todas las secciones (también con la tecla A para hablar). *@
        <button type="button" class="assistant-fab @(assistantOpen ? "open" : "") @(listening ? "is-listening" : "")" @onclick="ToggleAssistant"
                aria-expanded="@(assistantOpen ? "true" : "false")" aria-controls="assistantPanel">
            <span class="fab-icon" aria-hidden="true">@(assistantOpen ? "✕" : listening ? "🎙" : thinking ? "⏳" : "🤖")</span>
            <span class="fab-label">@(assistantOpen ? "Cerrar asistente" : "Asistente")</span>
        </button>
        @* Estado breve para lectores de pantalla: solo cambia (y se anuncia) cuando cambia el estado. *@
        <div class="visually-hidden" role="status" aria-live="polite" aria-atomic="true">@announce</div>
        <div id="assistantPanel" class="assistant-float" hidden="@(!assistantOpen)" role="dialog" aria-modal="false" aria-labelledby="assistantTitle"
             @onkeydown="OnAssistantKey" data-no-shortcuts>
            <div class="assistant" role="group" aria-labelledby="assistantTitle">
                <div class="assistant-head">
                    <h3 id="assistantTitle">Asistente</h3>
                    @if (StateLabel.Length > 0)
                    {
                        <span class="state-chip state-@stateNow.ToString().ToLowerInvariant()" aria-hidden="true">@StateLabel</span>
                    }
                    <button type="button" class="btn btn-small btn-outline" @onclick="ToggleAssistant">✕ Cerrar</button>
                </div>
                <div class="assistant-bar voice-bar" role="group" aria-label="Voz">
                    <button type="button" class="btn btn-outline" @onclick="StopVoice">⏹ Detener voz</button>
                    <button type="button" class="btn btn-outline" @onclick="() => SetOwnVoice(!ownVoice)" aria-pressed="@(ownVoice ? "true" : "false")">
                        @(ownVoice ? "🔈 Voz de SONORA: activada" : "🔇 Voz de SONORA: desactivada")
                    </button>
                </div>
                @if (guideOn)
                {
                    <GuidePanel Flow="guide" Version="guide.Version" FocusRequest="guideFocus" Busy="busy" Js="js"
                                Playing="@(current?.Playing == true)" HasContent="@(analysis is not null)"
                                OnOption="GuideOption" OnChange="GuideChange" OnAction="GuideAction" OnYear="GuideYear"
                                OnMore="GuideMore" OnLess="GuideLess" OnBack="GuideBack" OnMenu="GuideMenu" />
                }
                else
                {
                    <button type="button" class="btn guide-start" @onclick="StartGuide">🧭 Activar guía hablada</button>
                }
                <div class="assistant-bar">
                    <button type="button" class="btn @(listening ? "is-listening" : "")" @onclick="ToggleListen" disabled="@(!voiceInSupported || thinking)"
                            aria-keyshortcuts="A" aria-pressed="@(listening ? "true" : "false")">
                        @(listening ? "⏹ Escuchando… (pulsa para terminar)" : thinking ? "⏳ Procesando…" : "🎙 Usar micrófono")
                    </button>
                    <form class="assistant-ask" @onsubmit="AskTyped" @onsubmit:preventDefault>
                        <label for="askText" class="visually-hidden">Escribe una pregunta o una orden para el asistente</label>
                        <input id="askText" type="text" @bind="typed" @bind:event="oninput" autocomplete="off" disabled="@thinking"
                               placeholder="Escribe una orden: «biomas de Ucayali», «dónde estoy»…" />
                        <button type="submit" class="btn btn-outline" disabled="@(thinking || string.IsNullOrWhiteSpace(typed))">Enviar</button>
                    </form>
                </div>
                @if (!voiceInSupported || micBlocked)
                {
                    <p class="hint">@(micBlocked ? "El micrófono no tiene permiso." : "Este navegador no reconoce la voz.") Todo funciona igual con el teclado, tocando los botones o escribiendo órdenes.</p>
                }
                @if (lastHeard is not null)
                {
                    <div class="heard" role="group" aria-label="Orden reconocida">
                        <p>Entendí: «<strong>@lastHeard</strong>»</p>
                        <button type="button" class="btn btn-small btn-outline" @onclick="CorrectHeard">✎ Corregir</button>
                    </div>
                }
                <div class="assistant-bar">
                    <button type="button" class="btn btn-small btn-outline @(handsFree ? "is-listening" : "")" @onclick="() => SetHandsFree(!handsFree)"
                            disabled="@(!voiceInSupported)" aria-pressed="@(handsFree ? "true" : "false")" aria-keyshortcuts="M">
                        @(handsFree ? "🔁 Manos libres activado" : "🔁 Manos libres")
                    </button>
                    <button type="button" class="btn btn-small btn-outline" @onclick="ReadPage" aria-keyshortcuts="L">📖 Leer la página</button>
                </div>
                <p class="hint">
                    <strong>En cualquier momento:</strong> «¿dónde estoy?», «¿qué puedo hacer aquí?», «repite», «volver», «menú»,
                    «explicación sencilla», «explicación detallada», «aprender a escuchar». <kbd>Esc</kbd> o <kbd>Ctrl</kbd> detienen la voz.
                </p>
                <p class="hint">
                    <strong>Navegar solo con la voz:</strong> «lee la página», «para de leer», «sigue leyendo», «siguiente sección»,
                    «qué secciones hay», «qué hay aquí», «ve a accesibilidad», «abre la pestaña clima», «pulsa descargar video»,
                    «activa alto contraste», «qué visualizaciones hay», «escucha la número 3». Con <kbd>M</kbd> (manos libres)
                    no hace falta pulsar nada: SONORA te escucha todo el tiempo.
                </p>
                <p class="hint">
                    Pulsa <kbd>A</kbd> o el botón y pide lo que quieras: «haz sonar el Sahara», «busca donde hay más humo», «más lento»,
                    «sube el volumen», «más científico», «escala blues», «solo la melodía», «centra el radar en el huracán»
                    o una pregunta como «¿por qué hay polvo sobre el Atlántico?». Di «ayuda» para oír todas las órdenes.
                    @(voiceInSupported ? "El reconocimiento de voz lo hace tu navegador (en Chrome, con servidores de Google); las preguntas libres las responde un modelo de OpenAI." : "Tu navegador no admite reconocimiento de voz (usa Chrome o Edge), pero puedes escribir tus preguntas.")
                </p>
                @if (chat.Count > 0)
                {
                    <ol class="chat" aria-label="Conversación con el asistente">
                        @foreach (var turn in chat.TakeLast(8))
                        {
                            <li class="@turn.Role"><span class="who">@(turn.Role == "user" ? "Tú:" : "SONORA:")</span>@turn.Text</li>
                        }
                    </ol>
                }
            </div>
        </div>

        <!-- ===================== Accesibilidad ===================== -->
        <section class="card" aria-labelledby="a11yTitle">
            <h2 id="a11yTitle">3. Accesibilidad</h2>
            <div class="a11y-grid">
                <fieldset>
                    <legend>Narración por voz</legend>
                    <label><input type="checkbox" checked="@speech" @onchange="OnSpeech" disabled="@(!speechSupported)" aria-keyshortcuts="V" /> Leer en voz alta cada paso y los lugares destacados</label>
                    <label>Velocidad <input type="range" min="0.6" max="1.8" step="0.1" value="@speechRate.ToString(System.Globalization.CultureInfo.InvariantCulture)" @oninput="OnSpeechRate" aria-valuetext="@($"{speechRate:0.0} veces")" /> <span class="val">@speechRate.ToString("0.0")×</span></label>
                    <label><input type="checkbox" checked="@ownVoice" @onchange="e => SetOwnVoice((bool)e.Value!)" disabled="@(!speechSupported)" /> Voz de SONORA (asistente, guía y lectura)</label>
                    <p class="hint">@(speechSupported ? "Si usas un lector de pantalla (NVDA, JAWS, VoiceOver, TalkBack), desactiva la voz de SONORA para que no se superpongan dos voces: los textos se anuncian igualmente por tu lector. La velocidad y esta opción se recuerdan en este navegador." : "Tu navegador no admite síntesis de voz.")</p>
                </fieldset>
                <fieldset>
                    <legend>Retroalimentación táctil</legend>
                    <label><input type="checkbox" checked="@haptics" @onchange="OnHaptics" disabled="@(!hapticsSupported)" /> Vibrar con el ritmo y el bajo</label>
                    <button type="button" class="btn btn-small btn-outline" @onclick="TestHaptics" disabled="@(!hapticsSupported)">Probar vibración</button>
                    <p class="hint">@(hapticsSupported ? "Pulso largo = bajo (humo / capa grave); pulsos cortos = golpes de ritmo." : "Este dispositivo o navegador no admite vibración (funciona en Chrome para Android).")</p>
                </fieldset>
                <fieldset>
                    <legend>Visualización</legend>
                    <label><input type="checkbox" checked="@highContrast" @onchange="e => highContrast = (bool)e.Value!" /> Alto contraste</label>
                    <label><input type="checkbox" checked="@largeText" @onchange="e => largeText = (bool)e.Value!" /> Texto grande</label>
                </fieldset>
                <fieldset>
                    <legend>Texto descriptivo</legend>
                    <button type="button" class="btn btn-small" @onclick="DownloadTranscript" disabled="@(analysis is null)">⬇ Descargar descripción completa (.txt)</button>
                    <button type="button" class="btn btn-small btn-outline" @onclick="ShowHelp" aria-keyshortcuts="H">⌨ Atajos de teclado</button>
                    <p class="hint">La transcripción describe la imagen, el contexto científico y cada paso musical.</p>
                </fieldset>
            </div>
        </section>

    </main>

    <footer>
        <p>Datos: NASA Earth Information Center y Scientific Visualization Studio (SVS 5669, 5603, 5688, 5687, 5572, 5436, 5554, 5624, 5616), GMAO (GEOS), NASA GIBS, POWER y Giovanni. Proyecto para el NASA Space Apps Challenge 2026 · The Earth Information Jukebox.</p>
        <p>Optimización: HBA.Evolutionary · Audio: Tone.js</p>
    </footer>

    @* Bienvenida accesible: modal mientras está abierta (el foco no se escapa), Enter acepta y Escape descarta. *@
    <dialog @ref="welcomeDlg" class="welcome" aria-labelledby="welcomeTitle" aria-describedby="welcomeText">
        <h2 id="welcomeTitle">Bienvenido a Sonora</h2>
        <p id="welcomeText">Escucha nuestro planeta. ¿Necesitas ayuda para navegar? Puedes activar la guía hablada o continuar sin ella.</p>
        <div class="welcome-actions" data-welcome-actions>
            <button type="button" class="btn btn-big" data-welcome-accept @onclick="() => WelcomeChoice(true)">Activar guía hablada</button>
            <button type="button" class="btn btn-big btn-outline" data-welcome-dismiss @onclick="() => WelcomeChoice(false)">Ahora no</button>
        </div>
        <p class="hint">Enter activa la guía y Escape continúa sin ella. La guía no enciende el micrófono: podrás usar el teclado, tocar los botones o, si quieres, elegir «Usar micrófono».</p>
    </dialog>

    <dialog @ref="helpDialog" aria-labelledby="helpTitle" class="help">
        <h2 id="helpTitle">Atajos de teclado</h2>
        <table>
            <tbody>
                <tr><th scope="row"><kbd>Espacio</kbd></th><td>Reproducir o pausar (al pausar se describe el paso actual)</td></tr>
                <tr><th scope="row"><kbd>←</kbd> <kbd>→</kbd></th><td>Paso anterior o siguiente (suena y se describe)</td></tr>
                <tr><th scope="row"><kbd>Inicio</kbd> <kbd>Fin</kbd></th><td>Primer o último paso</td></tr>
                <tr><th scope="row"><kbd>↑</kbd> <kbd>↓</kbd></th><td>Modo exploración: recorre las 8 franjas horizontales (latitudes en el mapa de la NASA) o, en modo radar, los 8 anillos desde el centro</td></tr>
                <tr><th scope="row"><kbd>Esc</kbd></th><td>Salir de la exploración y volver al paso completo</td></tr>
                <tr><th scope="row"><kbd>A</kbd></th><td>Usar el micrófono para hablar con el asistente (vuelve a pulsar para terminar). Di «ayuda» para oír las órdenes. El botón «Asistente» abre la guía hablada sin micrófono</td></tr>
                <tr><th scope="row"><kbd>M</kbd></th><td>Modo manos libres: el asistente te escucha todo el tiempo, sin pulsar nada (vuelve a pulsar para apagarlo)</td></tr>
                <tr><th scope="row"><kbd>L</kbd></th><td>Leer toda la página en voz alta; vuelve a pulsar para detener o seguir donde iba</td></tr>
                <tr><th scope="row"><kbd>Ctrl</kbd> / <kbd>Esc</kbd></th><td>Detener al instante la voz de SONORA (lectura de la página, explicación o respuesta)</td></tr>
                <tr><th scope="row"><kbd>D</kbd></th><td>Describir con detalle el paso actual</td></tr>
                <tr><th scope="row"><kbd>V</kbd></th><td>Activar o desactivar la narración por voz</td></tr>
                <tr><th scope="row"><kbd>1</kbd>–<kbd>5</kbd></th><td>Silenciar o activar cada capa (melodía, ritmo, bajo, armonía, destellos)</td></tr>
                <tr><th scope="row">Doble clic</th><td>En modo radar, mueve el centro del giro a ese punto de la imagen</td></tr>
                <tr><th scope="row"><kbd>E</kbd></th><td>Cambiar a la siguiente escala musical (pentatónica, mayor, menor, dórica, blues, hirajoshi, tonos enteros)</td></tr>
                <tr><th scope="row"><kbd>H</kbd></th><td>Mostrar esta ayuda</td></tr>
            </tbody>
        </table>
        <p class="hint">Con lector de pantalla, entra en el explorador sonoro (zona de la imagen) para que las flechas lleguen a SONORA.</p>
        <button type="button" class="btn" @onclick="CloseHelp">Cerrar</button>
    </dialog>
</div>

@code {
    IJSObjectReference? js;
    DotNetObjectReference<Home>? self;
    ElementReference stage, canvas, img, video, helpDialog;
    InputFile? fileInput;

    AnalysisInfo? analysis;
    StepInfo? current;
    List<string> summary = [];
    ParetoResult? pareto;
    int selected, mismatches;
    bool useManual, optimizing;

    bool busy, loading;
    int progressPct;
    string progressMsg = "", status = "Cargando SONORA…";
    string? error;
    string userDescription = "";

    int tempo = 88, volume = 80, yearSec = 4;
    List<ScaleInfo> scales = [];
    string scaleId = "pent-minor";
    ScaleInfo? Scale => scales.FirstOrDefault(s => s.Id == scaleId);
    bool showClass, speech, haptics, highContrast, largeText, speechSupported, hapticsSupported;
    double speechRate = 1.0;
    readonly Dictionary<string, bool> muted = Roles.All.Append("points").ToDictionary(r => r, _ => false);

    // Asistente de voz
    bool listening, thinking, voiceInSupported;
    string typed = "", lastReply = "";
    readonly List<AssistantTurn> chat = [];
    DateTime quietUntil; // mientras el asistente actúa, los avisos de OnStep no pisan su respuesta

    // Guía hablada, bienvenida, estado visible y preferencias
    readonly GuideFlow guide = new();
    readonly StatusAnnouncer announcer = new();
    bool guideOn, guideLoading, welcomeOpen, ownVoice = true, micBlocked, explaining, resumeAfterExplain;
    bool? guidePref;              // última elección en la bienvenida (se recuerda en este navegador)
    int guideFocus;               // se incrementa para mover el foco a la primera opción de la guía
    string announce = "";         // texto de la región aria-live de estado
    string? lastHeard;            // última orden reconocida por el micrófono (se puede corregir)
    ContentMeta? meta;            // fuente, periodo y descripción del contenido cargado (para las explicaciones)
    ElementReference welcomeDlg;
    CancellationTokenSource? demoCts;
    List<EicItem> eicItems = [];
    AppState stateNow => StatusAnnouncer.Compute(listening, thinking, busy, analysis is not null, current?.Playing == true);
    string StateLabel => StatusAnnouncer.Label(stateNow);

    /// <summary>Preferencias locales. El micrófono no está aquí a propósito: nunca se restaura al recargar.</summary>
    sealed record UserPrefs(double? SpeechRate, int? Volume, bool? Guide, bool? OwnVoice);

    static readonly GuideEic SampleEic = new("sample", "Aerosoles GEOS · 19 ago 2025", "Aire", "19 ago 2025", "NASA SVS 5669",
        "Polvo del Sahara hacia el huracán Erin, humo de África y sal marina, con la paleta oficial de la NASA.");

    // Biomas de Perú (/api/biomas)
    BiomasCatalog? biomas;
    string bTipo = "biomas", bRegion = "peru";
    int bAnio = 2024;
    BiomasTipo? BTipo => biomas?.Tipos.FirstOrDefault(t => t.Id == bTipo);
    bool BiomasReady => biomas?.Estado == "listo";

    ParetoSolution Selection => useManual || pareto!.Front.Count == 0 ? pareto!.Manual : pareto.Front[selected];

    // Posición del deslizador de equilibrio en 0–100 (0 = lo más musical, 100 = lo más científico).
    int BalancePct => pareto is { Front.Count: > 1 } p ? (int)Math.Round(selected * 100.0 / (p.Front.Count - 1)) : 50;

    string StageLabel => analysis is null
        ? "Explorador sonoro. Cargando."
        : $"Explorador sonoro de {analysis.Title}. {analysis.Alt} Usa las flechas para recorrer y Espacio para reproducir.";

    string BalanceText => pareto is null ? "" :
        $"Solución {selected + 1} de {pareto.Front.Count}: fidelidad {Describer.Pct(pareto.Front[selected].Fidelity)}, musicalidad {Describer.Pct(pareto.Front[selected].Musicality)}";

    static string Rgb(int[] c) => $"rgb({c[0]},{c[1]},{c[2]})";

    static IEnumerable<(string, string)> ParamRows(MappingParams p)
    {
        string N(double v) => v.ToString("0.00", System.Globalization.CultureInfo.GetCultureInfo("es-ES"));
        yield return ("Suavizado melodía", N(p.SmoothMel));
        yield return ("Suavizado ritmo", N(p.SmoothRhy));
        yield return ("Umbral melodía", N(p.MelThr));
        yield return ("Curva de tono (γ)", N(p.Gamma));
        yield return ("Rango de notas", $"{p.PitchSpan} desde la nota {p.PitchLow + 1} de 15");
        yield return ("Ritmo → 1 / 2 / 4 golpes", $"{N(p.Rhy1)} / {N(p.Rhy2)} / {N(p.Rhy4)}");
        yield return ("Umbral bajo", N(p.BassThr));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            // Escuchando, Procesando, Cargando, Reproduciendo, En pausa: se anuncia solo cuando cambia.
            if (announcer.Update(stateNow) is { } said) { announce = said; StateHasChanged(); }
            return;
        }
        js = await JS.InvokeAsync<IJSObjectReference>("import", "./js/sonora.js");
        self = DotNetObjectReference.Create(this);
        await js.InvokeVoidAsync("init", self, stage, canvas, img, video);
        await js.InvokeVoidAsync("setTempo", tempo);
        scales = await js.InvokeAsync<List<ScaleInfo>>("scales");
        speechSupported = await js.InvokeAsync<bool>("speechSupported");
        hapticsSupported = await js.InvokeAsync<bool>("hapticsSupported");
        voiceInSupported = await js.InvokeAsync<bool>("listenSupported");
        // Idioma automático: la cultura del navegador (CultureInfo.CurrentUICulture en Blazor WebAssembly).
        // Español si el navegador está en español; inglés en cualquier otro idioma. La voz y el asistente lo siguen.
        if (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName != "es") await ApplyLang("en");
        await js.InvokeAsync<bool>("initWorldMap", worldMapEl, wAnio);
        await js.InvokeAsync<bool>("initContextMap", ctxMapEl);
        await js.InvokeAsync<bool>("initLegend", legendEl);
        await LoadPrefs();
        await OpenWelcome();
        _ = WatchBiomasCatalog();
        _ = LoadGuideCatalogs();
        await LoadSample();
    }

    // ---------- Preferencias locales ----------
    async Task LoadPrefs()
    {
        if (js is null) return;
        var p = await js.InvokeAsync<UserPrefs?>("loadPrefs");
        if (p is null) return;
        speechRate = Math.Round(Math.Clamp(p.SpeechRate ?? speechRate, 0.6, 1.8), 1);
        volume = Math.Clamp(p.Volume ?? volume, 0, 100);
        guidePref = p.Guide;
        ownVoice = p.OwnVoice ?? true;
        await js.InvokeVoidAsync("setVolume", volume);
        await js.InvokeVoidAsync("setOwnVoice", ownVoice);
    }

    Task SavePrefs() => js is null ? Task.CompletedTask : js.InvokeVoidAsync("savePrefs", new UserPrefs(speechRate, volume, guidePref, ownVoice)).AsTask();

    /// <summary>Catálogos reales para la guía (el Jukebox y las tendencias tienen sus propios componentes en pantalla).</summary>
    async Task LoadGuideCatalogs()
    {
        guide.Data.Places = [.. WorldPlaces.Select(p => new GuidePlace(p.Id, p.Name))];
        try { eicItems = await Http.GetFromJsonAsync<List<EicItem>>("api/eic/catalogo") ?? []; }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException) { eicItems = []; }
        guide.Data.Eic = [SampleEic, .. eicItems.Select(e => new GuideEic(e.Id, e.Titulo, e.Tema, e.Periodo, e.Fuente, e.Descripcion, e.Contexto))];
        try
        {
            var t = await Http.GetFromJsonAsync<TendenciasCatalog>("api/tendencias/catalogo");
            guide.Data.Tendencias = t is { Estado: "listo" } ? t : null;
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException) { }
        StateHasChanged();
    }

    // ---------- Biomas de Perú ----------

    /// <summary>Lee el catálogo y, mientras el servidor prepara el atlas, vuelve a consultar cada 3 s (hasta 3 minutos).</summary>
    async Task WatchBiomasCatalog()
    {
        for (int i = 0; i < 60; i++)
        {
            try
            {
                biomas = await Http.GetFromJsonAsync<BiomasCatalog>("api/biomas/catalogo");
                if (biomas is not null) bAnio = Math.Clamp(bAnio, biomas.AnioMin, biomas.AnioMax);
                guide.Data.Biomas = biomas;
                StateHasChanged();
                if (biomas?.Estado is "listo" or "error") return;
            }
            catch (HttpRequestException) { }
            await Task.Delay(3000);
        }
    }

    async Task<BiomasInfo> FetchBiomas(string url)
    {
        var resp = await Http.GetAsync(url);
        if (!resp.IsSuccessStatusCode)
        {
            var problem = await resp.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
            string msg = problem.TryGetProperty("detail", out var d) ? d.GetString()! : problem.TryGetProperty("error", out var e) ? e.GetString()! : resp.ReasonPhrase ?? "error";
            throw new InvalidOperationException(msg);
        }
        return (await resp.Content.ReadFromJsonAsync<BiomasInfo>())!;
    }

    const string BiomasFuente = "Red neuronal de SONORA con datos de la NASA (GIBS: MODIS y SRTM)";

    Task LoadBiomas(string tipo, int? anio, string region)
    {
        (bTipo, bRegion) = (tipo, region);
        if (anio is int a) bAnio = a;
        meta = new(BiomasFuente, anio?.ToString() ?? (biomas is null ? null : $"{biomas.AnioMin} a {biomas.AnioMax}"), BTipo?.Descripcion);
        string url = $"api/biomas/info?tipo={tipo}&region={region}" + (anio is int y ? $"&anio={y}" : "");
        return Run(async () => await js!.InvokeAsync<AnalysisInfo>("loadGeoImage", await FetchBiomas(url)), optimize: true);
    }

    Task LoadBiomasSerie(string tipo, string region)
    {
        (bTipo, bRegion) = (tipo, region);
        meta = new(BiomasFuente, biomas is null ? null : $"{biomas.AnioMin} a {biomas.AnioMax}, año por año", BTipo?.Descripcion);
        return Run(async () => await js!.InvokeAsync<AnalysisInfo>("loadGeoSeries", await FetchBiomas($"api/biomas/serie?tipo={tipo}&region={region}")), optimize: true);
    }

    // ---------- Tendencias del clima en Perú (datos y red de TrendDetective, /api/tendencias) ----------
    Task LoadTendencias(string url)
    {
        string fuenteId = System.Text.RegularExpressions.Regex.Match(url, @"[?&]fuente=([^&]+)").Groups[1].Value;
        var f = guide.Data.Tendencias?.Fuentes.FirstOrDefault(x => x.Id == Uri.UnescapeDataString(fuenteId));
        meta = new(f is null ? "NASA POWER o NASA Giovanni, series anuales calculadas por TrendDetective" : $"{f.Nombre}, series anuales calculadas por TrendDetective",
                   f is null ? null : $"{f.AnioMin} a {f.AnioMax}, año por año");
        return Run(async () => await js!.InvokeAsync<AnalysisInfo>("loadGeoSeries", await FetchBiomas(url)), optimize: true);
    }

    // ---------- Idioma (español / inglés) ----------
    string lang = "es";
    string? translatorNote;
    async Task ApplyLang(string l)
    {
        if (js is null) return;
        lang = l;
        var state = await js.InvokeAsync<string>("setLang", l);
        // Sin el traductor del navegador solo se traducen los textos fijos; se avisa una vez, en inglés.
        translatorNote = l == "en" && state is "none" or "unavailable"
            ? "English mode: the interface and the NASA catalog are in English. Some descriptions generated while you listen stay in Spanish because this browser has no built-in translator (Chrome 138 or later translates them too)."
            : l == "en" && state is "downloadable" or "downloading"
                ? "English mode: the browser is downloading its translator; descriptions will appear in English in a moment."
                : null;
        StateHasChanged();
    }

    // ---------- Pestañas (fuentes y detalles del reproductor) ----------
    static readonly List<(string Id, string Text)> SrcTabs =
        [("eic", "🎵 Jukebox NASA (EIC)"), ("archivo", "⬆ Tu archivo"), ("biomas", "🇵🇪 Biomas de Perú"), ("clima", "📈 Clima de Perú"), ("mundo", "🌎 Todo el planeta")];
    static readonly List<(string Id, string Text)> PlayerTabs =
        [("capas", "🎚 Capas"), ("mapa", "🗺 Mapa"), ("info", "📖 Qué estás escuchando")];
    string srcTab = "eic", playerTab = "capas";

    async Task SetSrcTab(string id) { srcTab = id; StateHasChanged(); if (id == "mundo" && js is not null) await js.InvokeVoidAsync("refreshMaps"); }
    async Task SetPlayerTab(string id) { playerTab = id; StateHasChanged(); if (id == "mapa" && js is not null) await js.InvokeVoidAsync("refreshMaps"); }

    // ---------- Jukebox del Earth Information Center (NASA SVS) ----------
    EicJukebox? eicBox;
    Task LoadEic(EicItem item)
    {
        meta = new(item.Fuente, item.Periodo, item.Descripcion, item.Contexto);
        return LoadEicCore(item);
    }
    Task LoadEicCore(EicItem item) => Run(async () =>
    {
        // Con hoja de cuadros (wwwroot/eic) no hay nada que descargar de la NASA: abre al instante.
        if (item.Hoja is not null) return await js!.InvokeAsync<AnalysisInfo>("loadEicSprite", item);
        if (!item.EnCache)
        {
            progressPct = 2; progressMsg = $"Descargando «{item.Titulo}» de NASA SVS ({item.Mb:0} MB, solo la primera vez)…";
            StateHasChanged();
        }
        using (var resp = await Http.PostAsync($"api/eic/preparar/{item.Id}", null))
            if (!resp.IsSuccessStatusCode) throw new InvalidOperationException($"NASA SVS no respondió ({(int)resp.StatusCode}). Prueba de nuevo en un momento.");
        eicBox?.MarkCached(item.Id);
        return await js!.InvokeAsync<AnalysisInfo>("loadEicVideo", item);
    }, optimize: true);

    // ---------- Descargar audio o video con sonido (grabación de una vuelta completa) ----------
    string? recording; // null, "audio" o "video"
    async Task Record(bool video)
    {
        if (js is null || analysis is null) return;
        if (recording is not null) { await js.InvokeAsync<System.Text.Json.JsonElement>("recordPiece", "", video); return; } // detener antes de tiempo
        recording = video ? "video" : "audio";
        status = video
            ? "Grabando el video: suena una vuelta entera con la imagen y el barrido, y luego se descarga."
            : "Grabando la pieza completa: suena una vuelta entera y luego se descarga el audio.";
        StateHasChanged();
        try
        {
            string name = new string(analysis.Title.Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray()).Trim('-');
            var r = await js.InvokeAsync<System.Text.Json.JsonElement>("recordPiece", "SONORA-" + (name.Length > 60 ? name[..60] : name), video);
            string ext = r.ValueKind == System.Text.Json.JsonValueKind.String ? r.GetString()! : "";
            status = $"{(video ? "Video" : "Audio")} descargado ({ext}). " +
                     (ext is ".mp4" or ".m4a" ? "Se abre con cualquier reproductor." : "Ábrelo con Chrome, Edge o VLC (arrastra el archivo a una ventana del navegador).");
        }
        catch (JSException ex) { error = ex.Message.Split('\n')[0]; status = error; }
        finally { recording = null; StateHasChanged(); }
    }

